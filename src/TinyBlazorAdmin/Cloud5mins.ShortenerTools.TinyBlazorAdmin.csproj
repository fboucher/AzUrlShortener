<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppVersion Condition="'$(AppVersion)' == ''">$(APP_VERSION)</AppVersion>
  </PropertyGroup>

  <Target Name="SetApplicationInformationalVersion" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup Condition="'$(AppVersion)' != ''">
      <InformationalVersion>$(AppVersion)</InformationalVersion>
    </PropertyGroup>

    <Exec
      Condition="'$(AppVersion)' == ''"
      Command="git describe --tags --dirty --always"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribeVersion" />
    </Exec>

    <PropertyGroup Condition="'$(AppVersion)' == '' and '$(_GitDescribeVersion)' != ''">
      <InformationalVersion>$(_GitDescribeVersion)</InformationalVersion>
    </PropertyGroup>

    <Error
      Condition="'$(AppVersion)' == '' and '$(_GitDescribeVersion)' == ''"
      Text="Unable to determine the application version. Build from a Git checkout or set APP_VERSION." />
  </Target>

  <ItemGroup>
	<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <PackageReference Include="Blazor.Bootstrap" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cloud5mins.ShortenerTools.TinyBlazorAdmin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Cloud5mins.ShortenerTools.Core.csproj" />
    <ProjectReference Include="..\ServiceDefaults\Cloud5mins.ShortenerTools.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>